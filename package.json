{
  "name": "fsweb-s15g4-node-testing-project-2",
  "version": "1.0.0",
  "description": "A tested REST API backed by SQLite and Knex.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "dev": "nodemon server.js",
    "rollback": "knex migrate:rollback --env=development",
    "migrate": "knex migrate:latest --env=development",
    "seed": "knex seed:run --env=development",
    "lint": "eslint . --ext .js",
    "test": "cross-env NODE_ENV=testing jest --runInBand",
    "sendresults": "npm test && node validateTask.js && node sendTestResults.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
